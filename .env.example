# EmailJS credentials for the enquiry form.
#
# Copy to .env.local and fill in. With a static export these are inlined into
# the JS bundle at build time, which is fine: an EmailJS public key is designed
# to be used from the browser and was previously hardcoded in two components
# (ContactForm.js and Modal.js) anyway. Keeping it here means it can be rotated
# without a code change.
#
# Values carried over from the old build, verify them in the EmailJS dashboard:
NEXT_PUBLIC_EMAILJS_SERVICE_ID=gmail
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=enquiry
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=user_qUwfyg8Rt1mateAvpSIap
