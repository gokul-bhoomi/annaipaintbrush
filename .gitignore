# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# firebase
/.firebase/

# generated images
#
# public/images and the PWA icons are derived from src/media by
# scripts/optimize-images.mjs, which runs automatically on `predev`/`prebuild`.
# Keeping ~2.9MB of derivatives out of git means src/media stays the single
# source of truth for artwork.
/public/images/
/public/icon-*.png
/public/apple-icon.png

# data/image-manifest.json is deliberately NOT ignored: it's imported at build
# time by components/ResponsiveImage.tsx, so `tsc --noEmit` and editor
# type-checking need it present in a fresh clone before any build has run.

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
